# Copy this file to .env and fill in the values you use.
# .env is gitignored. These values are placeholders, not real secrets.

# Required for the default OpenAI path.
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Optional. Defaults are openai and gpt-4o-mini.
# LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-4o-mini

# Optional local model. Ollama must be running and the model pulled, for example:
#   ollama pull llama3.2
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
